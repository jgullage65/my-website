# Clerk authentication (configure separately for local, preview, and production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Background crawler authentication and the trusted origin that is allowed to
# receive it. Production must use an HTTPS origin without a path or query.
CRON_SECRET=
AI_BUILDER_INTERNAL_ORIGIN=http://localhost:3000

# Dedicated, non-production PostgreSQL database for destructive AI Builder
# review-command integration tests. Its database name must include `test`.
# Never set this to the same URL as DATABASE_URL.
DATABASE_URL_TEST=
# Optional standard API price overrides, in USD per one million tokens.
AI_BUILDER_CRAWLER_INPUT_USD_PER_MILLION_TOKENS=
AI_BUILDER_CRAWLER_OUTPUT_USD_PER_MILLION_TOKENS=
# Dedicated server-to-server bearer secret for /api/internal/leadforge/research.
LEADFORGE_RESEARCH_API_SECRET=
